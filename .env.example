# Copy this file to .env (same folder) and replace the placeholders.
# .env is git-ignored; never commit your real keys.
#
# Consumed by llm.py through python-dotenv.

# DeepSeek - used by Orchestrator, TaskExecutor and CodeRunner.
# Create at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=REPLACE_ME

# Qwen (Alibaba Cloud Model Studio / DashScope) - used by DataAnalyzer (qwen-vl-max)
# for reading simulation plots and result files.
# Create at https://bailian.console.aliyun.com (API-KEY)
QWEN_API_KEY=REPLACE_ME
