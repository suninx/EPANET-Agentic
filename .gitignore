# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- IDE ---
.idea/
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- EPANET / WNTR run artifacts ---
# is_runnable_inp() calls run_sim() without a prefix, so temp.{inp,bin,rpt}
# land in the working directory; .rpt/.bin/.out are simulation output files.
temp.*
**/temp.*
*.rpt
*.bin
*.out
*.log

# --- Agent scratch files written into code_dir/ by tools.py and CodeRunner ---
# control_wn.pickle (add_multiple_controls), scenario.pickle (apply_disaster_scenario),
# plus generated plots/data. Inputs under code_dir/data/ stay tracked.
*.pickle
*.pkl
code_dir/*.png
code_dir/*.txt
code_dir/*.csv
code_dir/*.json
code_dir/*.md

# --- Local secrets ---
# .env holds real API keys, .env.example is the committed template.
.env
.env.*
!.env.example
